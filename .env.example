# Copy to .env and fill in. Never commit .env.
# In GitHub Actions these become repository secrets instead.

# --- Gmail (IMAP, app password) ---
# 1. 2-Step Verification must be ON: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Create an app password:        https://myaccount.google.com/apppasswords
#    Name it "morning-brief". Google shows 16 characters - paste them here.
#    Spaces are ignored, so "abcd efgh ijkl mnop" is fine.
# This password grants full mailbox access. Treat it like your password.
# Revoke it any time from the same page.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=

# --- Calendar (secret iCal URL) ---
# Google Calendar > hover your calendar > three dots > Settings and sharing >
# "Integrate calendar" > "Secret address in iCal format". Copy the whole URL.
# Anyone holding this URL can read your calendar. Reset it there if it leaks.
CALENDAR_ICAL_URL=

# --- Telegram ---
# Create a bot with @BotFather, message it once, then run:
#   python scripts/get_telegram_chat_id.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM ---
# synthesis provider: anthropic | gemini
LLM_SYNTHESIS_PROVIDER=gemini
# triage provider:    gemini | anthropic | none
#   "none" skips LLM triage entirely and relies on deterministic rules only (free)
LLM_TRIAGE_PROVIDER=gemini

ANTHROPIC_API_KEY=
# Google AI Studio key: https://aistudio.google.com/apikey
# Free tier covers Flash models. Google AI Pro also grants $10/mo of Cloud
# credits for the API, but you must activate them via one.google.com + google.dev.
GEMINI_API_KEY=

# --- Behaviour ---
TIMEZONE=Asia/Kolkata
LOOKBACK_HOURS=24
