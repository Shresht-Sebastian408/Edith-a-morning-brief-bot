# Copy to .env and fill in. Never commit .env.
# In GitHub Actions these become repository secrets instead.

# --- Google (Gmail + Calendar) ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# IMPORTANT: set the OAuth consent screen to "In production", NOT "Testing",
# or the refresh token below silently expires after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produced by: python scripts/bootstrap_google_auth.py
GOOGLE_REFRESH_TOKEN=

# --- Telegram ---
# Create a bot with @BotFather, then message it once and run:
#   python scripts/get_telegram_chat_id.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM ---
# synthesis provider: anthropic | gemini
LLM_SYNTHESIS_PROVIDER=gemini
# triage provider:    gemini | anthropic | none
#   "none" skips LLM triage entirely and relies on deterministic rules only (free)
LLM_TRIAGE_PROVIDER=gemini

ANTHROPIC_API_KEY=
# Google AI Studio key: https://aistudio.google.com/apikey
# Free tier covers Flash models. Google AI Pro also grants $10/mo of Cloud
# credits for the API, but you must activate them via one.google.com + google.dev.
GEMINI_API_KEY=

# --- Behaviour ---
TIMEZONE=Asia/Kolkata
LOOKBACK_HOURS=24
